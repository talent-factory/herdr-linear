# Herdr Linear Configuration
# Copy this file to .env and fill in your values

# Linear API Configuration
# Get your API key from: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_YOUR_KEY_HERE

# Logging Configuration
# Options: off, error, warn, info, debug, trace
RUST_LOG=info

# For development with maximum verbosity
# RUST_LOG=herdr_linear=debug,debug

# HTTP Timeout (seconds)
# HTTP_TIMEOUT=30

# Linear API Endpoint (usually no need to change)
# LINEAR_API_ENDPOINT=https://api.linear.app/graphql

# Rate Limiting
# Enable automatic rate limit handling
# ENABLE_RATE_LIMIT_RETRY=true

# Retry Configuration
# Maximum number of retries for failed requests
# MAX_RETRIES=3

# Connection Pooling
# Maximum number of concurrent HTTP connections
# MAX_CONCURRENT_REQUESTS=10
